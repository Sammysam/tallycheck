{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TallyCheck",
  "version": "0.2.0",
  "identifier": "lk.cenango.accounting",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Cenango (Pvt) Ltd",
    "shortDescription": "TallyCheck",
    "longDescription": "Offline accounting, employees and payroll.",
    "copyright": "Copyright (C) 2026 Cenango (Pvt) Ltd. Licensed under the GNU AGPL v3 or a commercial license.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../frontend/dist/": "frontend/"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2ODhBMjU0NTA3QjFFQzkKUldUSkhudFFWS0tJcGg2SGgvTmoyeTZ0ekl3UmV6ekJrOTFNNTJJVmlkYnlwcXA5MVJ2d2F0d2wK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
