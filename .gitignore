/target
**/target
/frontend/node_modules
/frontend/dist
/data
*.db
*.db-wal
*.db-shm
*.sqlite
.env
.env.*
*.dpapi
*.key
# Apple provisioning profiles and certificates stay in the company password manager (D58).
*.provisionprofile
*.p12
*.p8
*.cer
/tests/contract/node_modules
/tests/contract/.scratch
/src-tauri/gen
/node_modules
/.scratch

# Local test output. The test code itself (crates/*/tests, tests/ui, tests/contract) stays in
# git; what running it leaves on this PC does not: screenshots, test books, logs.
/tests/**/screenshots/
/tests/**/shots/
/tests/**/out/
/tests/**/*.png
/test-data/
/test-output/
/screenshots/
*.log

# Archives of local work (e.g. zipped folders) can contain test data or secrets.
*.zip

# Graphify code map (local, rebuilt with: graphify update .)
graphify-out/

# Python bytecode
__pycache__/

# Pre-flight reports (Preserve)
preflight-out/
